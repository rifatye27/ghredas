// Программа проверяет, является ли введённый год високосным

#include <iostream> //  Для ввода-вывода
#include <windows.h> // Для установки кодировки UTF-8 в консоли Windows

int main() {
    // Установка кодировки UTF-8 для корректного отображения кириллицы
    SetConsoleCP(65001);        // Кодировка ввода
    SetConsoleOutputCP(65001);  // Кодировка вывода
    int year; // Год для проверки
    std::cout << "Введите год: "; // Запрос на ввод года
    std::cin >> year; // Ввод года

    if ((year % 4 == 0 && year % 100 != 0) || (year % 400 == 0)) { // Проверка на високосность
        std::cout << year << " - високосный год\n"; // Вывод результата
    } else {
        std::cout << year << " - не високосный год\n"; // Вывод результата
    }
    return 0; // Завершение программы с кодом возврата 0
}
