// Задача: определить возрастную категорию человека по введённому возрасту

#include <iostream>   // Подключение библиотеки для ввода-вывода
#include <windows.h>  // Подключение для настройки кодировки консоли Windows

int main() {
    // Установка кодировки UTF-8 для корректного отображения кириллицы
    SetConsoleCP(65001);        // Кодировка ввода
    SetConsoleOutputCP(65001);  // Кодировка вывода

    int age;  // Переменная для хранения возраста

    // Запрос возраста у пользователя
    std::cout << "Введите ваш возраст: ";
    std::cin >> age;  // Считывание возраста

    // Определение возрастной категории
    if (age < 0) {
        // Отрицательный возраст — ошибка
        std::cout << "Некорректный возраст\n";
    } else if (age <= 12) {
        // От 0 до 12 лет
        std::cout << "Ребёнок\n";
    } else if (age <= 17) {
        // От 13 до 17 лет
        std::cout << "Подросток\n";
    } else if (age <= 60) {
        // От 18 до 60 лет
        std::cout << "Взрослый\n";
    } else {
        // Старше 60 лет
        std::cout << "Пожилой\n";
    }

    return 0;  // Успешное завершение программы
}
