// Задача: определить, является ли введённое число кратным 3

#include <iostream>   // Подключение библиотеки для ввода-вывода
#include <windows.h>  // Подключение для настройки кодировки консоли Windows

int main() {
    // Установка кодировки UTF-8 для корректного отображения кириллицы
    SetConsoleCP(65001);        // Кодировка ввода
    SetConsoleOutputCP(65001);  // Кодировка вывода

    int number;  // Переменная для хранения введённого числа

    // Запрос числа у пользователя
    std::cout << "Введите число: ";
    std::cin >> number;  // Считывание целого числа с клавиатуры

    // Проверка: делится ли число на 3 без остатка
    if (number % 3 == 0) {
        // Если остаток от деления равен 0 — число кратно 3
        std::cout << "Число " << number << " - кратное 3\n";
    } else {
        // Иначе — число не кратно 3
        std::cout << "Число " << number << " - не кратное 3\n";
    }

    return 0;  // Успешное завершение программы
}
