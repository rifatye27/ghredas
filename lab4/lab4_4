// Задача: Решение квадратного уравнения (a*x^2 + b*x + c = 0) с выводом корней или сообщения о их отсутствии

#include <iostream> // Для ввода и вывода данных
#include <cmath> // Для использования функции std::sqrt()
#include <iomanip> // Для установки точности вывода чисел с плавающей запятой
#include <windows.h> // Для установки кодировки UTF-8 в консоли Windows

int main() {
    // Установка кодировки UTF-8 для корректного отображения кириллицы
    SetConsoleCP(65001);        // Кодировка ввода
    SetConsoleOutputCP(65001);  // Кодировка вывода
    double a, b, c; // Коэффициенты квадратного уравнения (a*x^2 + b*x + c = 0)
    std::cout << "Введите a: "; // Ввод коэффициента a
    std::cin >> a;
    std::cout << "Введите b: "; // Ввод коэффициента b
    std::cin >> b;
    std::cout << "Введите c: "; // Ввод коэффициента c
    std::cin >> c;

    if (a == 0) { // Проверка, является ли уравнение квадратным
        std::cout << "Это не квадратное уравнение.\n"; // Сообщение о том, что уравнение не является квадратным
    } else {
        double D = b * b - 4 * a * c; // Вычисление дискриминанта

        std::cout << std::fixed << std::setprecision(2);  // Установка точности вывода до 2 знаков после запятой

        if (D > 0) { // Два различных корня
            double x1 = (-b + std::sqrt(D)) / (2 * a); // Вычисление первого корня
            double x2 = (-b - std::sqrt(D)) / (2 * a); // Вычисление второго корня
            std::cout << "Два корня: " << x1 << " и " << x2 << "\n";
        } else if (D == 0) { // Один корень
            double x = -b / (2 * a); // Вычисление единственного корня
            std::cout << "Один корень: " << x << "\n";
        } else { // Нет действительных корней
            std::cout << "Корней нет\n";
        }
    }
    return 0; // Завершение программы с кодом возврата 0
}
