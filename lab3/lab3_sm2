// Программа переводит число из десятичной системы в двоичную, восьмеричную и шестнадцатеричную

#include <iostream>  // Для ввода-вывода
#include <bitset>    // Для перевода в двоичную систему
#include <windows.h> // Для установки кодировки UTF-8 в консоли Windows

int main() {
    // Установка кодировки UTF-8 для корректного отображения кириллицы
    SetConsoleCP(65001);        // Кодировка ввода
    SetConsoleOutputCP(65001);  // Кодировка вывода

    int number;  // Число для перевода

    std::cout << "Введите целое число: ";  // Запрос числа
    std::cin >> number;

    // Перевод в двоичную систему (показываем 8 бит)
    std::cout << "Двоичная:        " << std::bitset<8>(number) << "\n";

    // Перевод в восьмеричную систему
    std::cout << "Восьмеричная:    " << std::oct << number << "\n";

    // Перевод в шестнадцатеричную систему
    std::cout << "Шестнадцатеричная: " << std::hex << number << "\n";

    return 0;  // Успешное завершение программы
}
